# Copy to .env.cloud on EC2. Replace every placeholder before starting.
SECRET_KEY=replace-with-a-long-random-secret
HR_PASSWORD=replace-with-your-hr-password
MANAGER_PASSWORD=replace-with-your-manager-password
S3_BUCKET=replace-with-your-private-bucket-name
AWS_DEFAULT_REGION=ap-south-1
# Set to 1 only when serving the application through HTTPS.
COOKIE_SECURE=0
